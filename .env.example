# Скопировать в .env: cp .env.example .env
POSTGRES_DB=moex
POSTGRES_USER=moex
POSTGRES_PASSWORD=moex
POSTGRES_PORT=5432
METABASE_PORT=3000

# Глубина истории для ETL
LOAD_FROM=2022-01-01

# Metabase. Пароль пустой намеренно: при первой настройке
# scripts/setup_metabase.sh сгенерирует случайный и допишет его сюда же,
# в .env, который в репозиторий не попадает. Своё значение можно вписать
# заранее — тогда скрипт возьмёт его.
MB_EMAIL=analyst@moex.local
MB_PASSWORD=
